// 同一ユーザー / 同一 Mac の MIDI 機材利用契約。正典: docs/design/03-runtime-service.md
// snapshot（type="json"）の形は crates/midistage-protocol/src/wire.rs の Snapshot が正。
// 2026-10-11: `service { version, executable }` を追加（省略可。design 05「常駐と配布」）。
// 2026-10-16: SetDeviceSetups / SelectSetup と、device の `configuring` / `current_setup` /
//   `setup_owners` / `config_error`（省略可）を追加（design 06「ROTO の setup を持ち主に合わせて切り替える」）。
// 2026-10-18: ApplyDeviceSetup を追加（design 06 の段 C。`content` の形は wire.rs の SetupContent =
//   clients/swift/Tests/MidistageClientTests/Fixtures/apply-device-setup.json が正）。本体ができるまで
//   `not_implemented` を返す。
protocol "midistage" version="1.0.0" {
    namespace "club.chronista.midistage"
    channel "midistage" from="client" lifetime="persistent" {
        request "Hello" {
            field "protocol_version" type="int" required=#true
            field "client_id" type="string" required=#true
            field "display_name" type="string" required=#true
            field "auth_token" type="string" required=#true
            field "native_midi" type="bool"
            field "initial_enabled_profiles" type="array<string>"
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "Snapshot" {
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "SetEnabled" {
            field "device_id" type="string" required=#true
            field "enabled" type="bool" required=#true
            field "expected_revision" type="int" required=#true
            field "takeover" type="bool"
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "Quiesced" {
            field "device_id" type="string" required=#true
            field "lease_token" type="string" required=#true
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "SendMidi" {
            field "device_id" type="string" required=#true
            field "lease_token" type="string" required=#true
            field "port_name" type="string" required=#true
            field "bytes" type="array<int>" required=#true
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "SetDeviceSetups" {
            field "device_id" type="string" required=#true
            field "setups" type="array<int>" required=#true
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "SelectSetup" {
            field "device_id" type="string" required=#true
            field "lease_token" type="string" required=#true
            field "setup" type="int" required=#true
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "ApplyDeviceSetup" {
            field "device_id" type="string" required=#true
            field "lease_token" type="string" required=#true
            field "setup" type="int" required=#true
            // { name, knobs: [KnobConfig], switches: [SwitchConfig] }。載っていない席は未設定にする。
            // KnobConfig = { control, mode: cc7|cc14|nrpn7|nrpn14, channel 1-16, param, nrpn_address, min, max,
            //   name (ASCII 12), color 0-82, haptics: {kind: smooth, indents:[0-127]} | {kind: steps, names:[2-16]} | {kind: centre_indent} }
            // SwitchConfig = { control, mode: +program_change|note, channel, param, nrpn_address, min (OFF 値), max (ON 値),
            //   name, color, led_on, led_off, action: push|toggle, step_names }
            field "content" type="json" required=#true
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        request "Present" {
            field "device_id" type="string" required=#true
            field "lease_token" type="string" required=#true
            field "controls" type="json" required=#true
            returns "Reply" { field "snapshot" type="json"; field "error" type="json"; }
        }
        event "Event" { field "kind" type="string" required=#true; }
    }
}
